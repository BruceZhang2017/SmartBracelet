<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/female_cycle_selected_bg" />
            <stroke android:width="2dp" android:color="@color/female_cycle_brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/female_cycle_unselected_bg" />
            <stroke android:width="1dp" android:color="@color/female_cycle_unselected_border" />
        </shape>
    </item>
</selector>
