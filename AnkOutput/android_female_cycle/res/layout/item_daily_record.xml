<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 左侧日期信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 日期 -->
            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12月26日"
                android:textColor="@color/female_cycle_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 周期天数 -->
            <TextView
                android:id="@+id/cycleDayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="第1天"
                android:textColor="@color/female_cycle_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 右侧图标容器 -->
        <LinearLayout
            android:id="@+id/iconContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 经期图标 -->
            <ImageView
                android:id="@+id/periodIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_droplet_medium"
                android:tint="@color/female_cycle_brand"
                android:visibility="gone" />

            <!-- 痛经图标 -->
            <ImageView
                android:id="@+id/painIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_lightning_moderate"
                android:tint="@color/female_cycle_brand"
                android:visibility="gone" />

            <!-- 性行为图标 -->
            <ImageView
                android:id="@+id/sexualActivityIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_heart"
                android:tint="@color/female_cycle_brand"
                android:visibility="gone" />

            <!-- 心情图标 -->
            <ImageView
                android:id="@+id/moodIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_mood_happy"
                android:tint="@color/female_cycle_brand"
                android:visibility="gone" />

            <!-- 身体症状图标 -->
            <ImageView
                android:id="@+id/bodySymptomsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_body"
                android:tint="@color/female_cycle_brand"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 右侧箭头 -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/female_cycle_text_hint" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
